{
  "$schema": "https://opencode.ai/config.json",
  

  "provider": {
    "sglang": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SGLang (Qwen3.8-27B)",
      "limit": {
        "context": 262144,
        "output": 65536
      },
      "options": {
        "baseURL": "http://192.168.0.220:30000/v1"
      },
      "models": {
        "RadixArk/Qwen3.8-27B-FP8": {
          "name": "Qwen3.8-27B-FP8"
        }
      }
    }
  },

  
  "default_agent": "plan",
  "subagent_depth": 1,
  
  
  "instructions": [
    "docs/product/PRODUCT_CONTRACT.md",
    "docs/architecture/ARCHITECTURE.md",
    "docs/security/SECURITY_INVARIANTS.md",
    "docs/testing/TESTING_STRATEGY.md"
  ],

  "permission": {
    
    
    "*": "deny",

    
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/*.p12": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny"
    },

    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "lsp": "allow",

    
    "external_directory": {
      "*": "deny"
    },

    
    "bash": {
      "*": "deny",

      
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-list*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git check-ignore*": "allow",
      "git remote -v": "allow",
      "git branch --list*": "allow",
      "git branch -l*": "allow",
      "git branch --show-current*": "allow",

      
      "cargo check*": "allow",
      "cargo test*": "allow",
      "cargo clippy*": "allow",
      
      "cargo fmt --check*": "allow",

      
      "pnpm test*": "allow",
      "pnpm lint*": "allow",
      "pnpm typecheck*": "allow",
      "pnpm run test*": "allow",
      "pnpm run lint*": "allow",
      "pnpm run typecheck*": "allow",

      
      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git restore*": "deny",
      "git clean*": "deny",
      "git stash*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git tag *": "deny",
      "git update-ref*": "deny",
      "git cherry-pick*": "deny",
      "git revert*": "deny",
      "git gc*": "deny",
      
      
      
      
      "git branch*": "deny",
      "git branch -d*": "deny",
      "git branch -D*": "deny",

      
      "rm *": "deny",
      "rmdir *": "deny",
      "del *": "deny",
      "rd *": "deny",
      "Remove-Item*": "deny",
      "Clear-Content*": "deny",

      
      "pnpm install*": "deny",
      "pnpm add*": "deny",
      "pnpm remove*": "deny",
      "pnpm dlx*": "deny",
      "npm *": "deny",
      "npx *": "deny",
      "cargo install*": "deny",
      "cargo add*": "deny",
      "cargo remove*": "deny",

      
      "curl *": "deny",
      "wget *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      
      "docker *": "deny",
      "sudo *": "deny"
    }
  }
}
