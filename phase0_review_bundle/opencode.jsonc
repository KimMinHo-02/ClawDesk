{
  "$schema": "https://opencode.ai/config.json",

  // ClawDesk Phase 0 harness config.
  // 기본은 read-only plan agent. 구현은 /phase-implement(clawdesk-build)로 전환.
  "default_agent": "plan",
  "subagent_depth": 1,

  // 계약 문서들을 system context에 연결.
  "instructions": [
    "docs/product/PRODUCT_CONTRACT.md",
    "docs/architecture/ARCHITECTURE.md",
    "docs/security/SECURITY_INVARIANTS.md",
    "docs/testing/TESTING_STRATEGY.md"
  ],

  "permission": {
    // 전역 기본 deny. legacy opencode.json의 "*": "allow"를 override(key 충돌 시 후속 파일 값이 이김).
    // 아래 per-tool 규칙이 전역 wildcard보다 우선한다(공식 문서: global `*` + tool override 패턴).
    "*": "deny",

    // 파일 읽기: repository 안은 allow, secret 자료는 deny.
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/*.p12": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny"
    },

    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "lsp": "allow",

    // ClawDesk repository 외부 filesystem 접근 금지.
    "external_directory": {
      "*": "deny"
    },

    // shell: 화이트리스트. 마지막에 매칭된 규칙이 이긴다(넓은 규칙을 앞에, 좁은 규칙을 뒤에).
    "bash": {
      "*": "deny",

      // git read-only만 허용.
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-list*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git check-ignore*": "allow",
      "git remote -v": "allow",
      "git branch --list*": "allow",
      "git branch -l*": "allow",
      "git branch --show-current*": "allow",

      // Rust 검증.
      "cargo check*": "allow",
      "cargo test*": "allow",
      "cargo clippy*": "allow",
      // 파일 재포맷(cargo fmt)은 금지, check만 허용.
      "cargo fmt --check*": "allow",

      // frontend 검증 계열.
      "pnpm test*": "allow",
      "pnpm lint*": "allow",
      "pnpm typecheck*": "allow",
      "pnpm run test*": "allow",
      "pnpm run lint*": "allow",
      "pnpm run typecheck*": "allow",

      // 명시적 deny(방어층: 기본은 이미 deny).
      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git restore*": "deny",
      "git clean*": "deny",
      "git stash*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git tag *": "deny",
      "git update-ref*": "deny",
      "git cherry-pick*": "deny",
      "git revert*": "deny",
      "git gc*": "deny",
      // 일반 git branch mutation(생성/삭제/이름변경/강제).
      // key가 legacy opencode.json의 "git branch*": "allow"와 충돌하여 merged config에서
      // 동일 키 위치(조기)의 deny로 대체된다. --show-current/--list allow는 이 key보다 늦은
      // 위치(merged tail)에 가서 last-match-wins로 살아남는다.
      "git branch*": "deny",
      "git branch -d*": "deny",
      "git branch -D*": "deny",

      // 파일 삭제/변경 cmdlet 및 shell 유틸.
      "rm *": "deny",
      "rmdir *": "deny",
      "del *": "deny",
      "rd *": "deny",
      "Remove-Item*": "deny",
      "Clear-Content*": "deny",

      // lockfile/의존성 mutation.
      "pnpm install*": "deny",
      "pnpm add*": "deny",
      "pnpm remove*": "deny",
      "pnpm dlx*": "deny",
      "npm *": "deny",
      "npx *": "deny",
      "cargo install*": "deny",
      "cargo add*": "deny",
      "cargo remove*": "deny",

      // 네트워크/권한 상승.
      "curl *": "deny",
      "wget *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      // legacy opencode.json의 "docker *": "ask"를 deny로 override.
      "docker *": "deny",
      "sudo *": "deny"
    }
  }
}
